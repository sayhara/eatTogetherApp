# Database
DB_HOST=localhost
DB_NAME=eattogether
DB_USER=postgres
DB_PASSWORD=password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (must be at least 32 characters)
JWT_SECRET=your-secret-key-must-be-at-least-32-chars-long

# OAuth2 - Google (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth2 - Kakao (https://developers.kakao.com)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# OAuth2 - Naver (https://developers.naver.com)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# App
APP_REDIRECT_URI=eattogether://oauth2/callback
ALLOWED_ORIGINS=http://localhost:3000

# Production only: public base URL used to build OAuth callback URLs
# (register this exact value + /login/oauth2/code/{provider} in each OAuth console)
# e.g. http://<EC2_PUBLIC_IP>:8080
OAUTH_REDIRECT_BASE_URL=http://localhost:8080

# FCM (Firebase - src/main/resources/firebase-service-account.json 에 파일 추가)
